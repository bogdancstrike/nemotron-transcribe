+    std::shared_ptr<const asr::SpeechLmDetails> force_align(
+        const float* samples, size_t n, int rate, const std::string& text) override {
+        if (!supports_forced_alignment())
+            throw std::invalid_argument("forced alignment requires the encoder CTC head");
+        if (text.empty() || text.size() > 2000000)
+            throw std::invalid_argument("alignment text must contain 1..2000000 UTF-8 bytes");
+        if (rate == 0) rate = sample_rate();
+        if (rate < 8000 || rate > 96000 || !n || !samples)
+            throw std::invalid_argument("invalid forced-alignment audio");
+        const double seconds = static_cast<double>(n) / rate;
+        if (const auto error = policy::duration_limit_error(seconds))
+            throw std::invalid_argument(*error);
+        std::vector<float> resampled;
+        if (rate != sample_rate()) {
+            resampled = audio::resample_audio(samples, n, rate, sample_rate());
+            samples = resampled.data(); n = resampled.size(); rate = sample_rate();
+        }
+        SalmRequest request{"", samples, n, rate};
+        request.seconds = seconds;
+        request.timestamps = true;
+        request.alignment_text = text;
+        auto raw = submit(std::move(request));
+        if (!raw.error.empty()) throw std::runtime_error(raw.error);
+        if (!raw.details || raw.details->alignment_status != "aligned" ||
+            raw.details->words.empty() || raw.details->unaligned_words > 0)
+            throw std::runtime_error("CTC could not align the complete supplied transcript");
+        raw.details->text = text;
+        raw.details->duration_seconds = seconds;
+        raw.details->transcript_origin = "analyst";
+        return raw.details;
+    }
