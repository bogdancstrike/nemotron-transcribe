# Copy to .env. Change only if needed.
WEB_PORT=7860
MODEL_QUANT=AD-IQ4_NL
NEMO_CPU_THREADS=12
MAX_UPLOAD_MB=2048
# Optional Hugging Face token if required by your account:
HF_TOKEN=

# bootstrap.sh automatically writes the current host UID and GID to .env:
# HOST_UID=1000
# HOST_GID=1000

# The default override targets RTX 3080. CPU fallback: docker compose -f compose.yaml up --build -d
NEMO_CPU_MOE_LAYERS=48
MAX_DURATION_SECONDS=14400
MIN_FREE_DISK_MB=1024
MAX_PENDING_JOBS=100
# 0 keeps files until you delete them; positive values expire done/failed jobs.
RETENTION_DAYS=0
